# Copy to .env on the VPS and fill in. Secrets never enter the repo (§9).

# Postgres (compose wires DATABASE_URL from this)
POSTGRES_PASSWORD=change-me

# Public hostname for Caddy TLS, e.g. app.everpresent.io — use ":80" until DNS points here
SITE_ADDRESS=:80

# Clerk (dashboard.clerk.com → API keys). JWKS URL is shown under the same page,
# https://<your-clerk-frontend-api>/.well-known/jwks.json
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=

# Seeded superadmin — linked to the Clerk account with this email on first login
SUPERADMIN_EMAIL=neil.bearse@gmail.com

ENV=prod
