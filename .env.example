# EverPresent — environment reference. Copy to .env and fill in; secrets never
# enter the repo (§9). Tags:  [REQUIRED] to boot ·  [DEMO] needed for the GoDaddy
# demo surfaces ·  [OPTIONAL] enables a feature, safe to leave blank.
#
# See docs/DEMO_READINESS.md for the full pre-demo checklist (keys, migrations,
# per-tenant admin config, and the smoke tests).

ENV=prod

# ── Core infrastructure ────────────────────────────────────────────────────
# Render: set DATABASE_URL / REDIS_URL from the managed Postgres + keyvalue.
# VPS/compose: set POSTGRES_PASSWORD (compose wires DATABASE_URL) and SITE_ADDRESS.
DATABASE_URL=postgresql+psycopg://user:pass@host:5432/everpresent   # [REQUIRED]
REDIS_URL=redis://host:6379/0                                       # [REQUIRED]
POSTGRES_PASSWORD=change-me                                         # (VPS/compose only)
SITE_ADDRESS=:80                                                    # (VPS/compose only) public host for Caddy TLS
# Raw answer payloads: "db" on Render (no shared disk), "file" on a VPS.
STORAGE_BACKEND=db                                                  # [REQUIRED]
RAW_STORAGE_DIR=/data/raw                                           # only for STORAGE_BACKEND=file

# ── Auth (Clerk) — orgs are tenants ────────────────────────────────────────
# dashboard.clerk.com → API keys. JWKS: https://<clerk-frontend-api>/.well-known/jwks.json
CLERK_PUBLISHABLE_KEY=                                              # [REQUIRED]
CLERK_SECRET_KEY=                                                   # [REQUIRED]
CLERK_JWKS_URL=                                                     # [REQUIRED]
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=                                  # [REQUIRED] (web service, build time)
SUPERADMIN_EMAIL=neil.bearse@gmail.com                             # [REQUIRED] seeded superadmin

# ── The five answer platforms ──────────────────────────────────────────────
# ChatGPT (OpenAI API + browser), Claude, Gemini, Perplexity (API + browser),
# Microsoft Copilot (browser only). A surface with no key is skipped with a
# clear reason, never a crash.
OPENAI_API_KEY=                                                    # [DEMO] ChatGPT (API)
ANTHROPIC_API_KEY=                                                 # [DEMO] Claude (API) AND steps 4 & 5 (utility LLM)
GEMINI_API_KEY=                                                    # [DEMO] Gemini (API)
PERPLEXITY_API_KEY=                                                # [DEMO] Perplexity (API)
# Copilot / ChatGPT-web / Perplexity-web use NO key — they need the proxy below.

# ── Anti-blocking: residential proxy (web surfaces + power-page crawl) ──────
# The browser surfaces AND the power-page crawler fetch Reddit/affiliate pages
# that 403 a datacenter IP. Set ONE of SCRAPE_PROXY_URL / SCRAPE_PROXY_MAP /
# SCRAPE_CDP_ENDPOINT. Without it, those surfaces mostly come back "blocked".
SCRAPE_PROXY_URL=                                                  # [DEMO] http://user:pass@host:port (e.g. Bright Data)
SCRAPE_PROXY_MAP=                                                  # [OPTIONAL] {"us":"http://...","ca":"http://..."} for location fan-out
SCRAPE_CDP_ENDPOINT=                                               # [OPTIONAL] managed scraping browser (proxy+captcha handled)
SCRAPE_STEALTH=true                                               # on by default; free hardening
SCRAPE_BLOCK_ASSETS=true                                          # on by default; ~halves proxy bytes
CHATGPT_WEB_RATE_PER_MIN=4
PERPLEXITY_WEB_RATE_PER_MIN=4
COPILOT_WEB_RATE_PER_MIN=4
CHATGPT_WEB_HEADLESS=true                                         # false only when debugging selectors

# ── Google AI Overviews (optional 6th surface) ─────────────────────────────
GOOGLE_AIO_PROVIDER=direct                                        # "serpapi" to use SerpApi instead of scraping the SERP
GOOGLE_AIO_RATE_PER_MIN=6
SERPAPI_KEY=                                                      # [OPTIONAL] required only when provider=serpapi

# ── Steps 4 & 5 (whitespace extraction + content generation) ───────────────
# No extra key — they use ANTHROPIC_API_KEY via the governed router. Enable
# per-tenant in the admin panel (ai_processing_approved + approved_utility_models
# + entity_extraction_enabled).
UTILITY_MODEL_EXTRACT=claude-haiku-4-5-20251001
UTILITY_MODEL_DRAFT=claude-sonnet-4-6

# ── Collection / cost knobs ────────────────────────────────────────────────
NATURAL_PROBE_FRACTION=0.34                                       # M2 routing probe (costed opt-in); 0 disables
DIAGNOSIS_REFRESH_DAYS=7                                          # reuse the training-only twin within this window
SERPAPI_COST_PER_SEARCH=0.0075                                    # cap-estimate only
SCRAPE_COST_PER_PAGE_USD=0.02                                     # cap-estimate only

# ── Run-completion emails (optional) ───────────────────────────────────────
SMTP_HOST=                                                       # [OPTIONAL] unset = no emails
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=reports@yourdomain.com
SMTP_STARTTLS=true

# ── BigQuery mirror + GA4 outcome attribution (optional, internal) ─────────
BIGQUERY_PROJECT=                                                # [OPTIONAL] unset = mirror disabled
BIGQUERY_DATASET=everpresent_v3
GOOGLE_SERVICE_ACCOUNT_JSON=                                     # [OPTIONAL] SA key path; GA4 SA needs Viewer on the tenant's property
MIRROR_HOUR_UTC=9                                                # nightly jobs (mirror, GA4 pull, power-page crawl) fire after this hour
GA4_LOOKBACK_DAYS=28
