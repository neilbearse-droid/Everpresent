# Copy to .env on the VPS and fill in. Secrets never enter the repo (§9).

# Postgres (compose wires DATABASE_URL from this)
POSTGRES_PASSWORD=change-me

# Public hostname for Caddy TLS, e.g. app.everpresent.io — use ":80" until DNS points here
SITE_ADDRESS=:80

# Clerk (dashboard.clerk.com → API keys). JWKS URL is shown under the same page,
# https://<your-clerk-frontend-api>/.well-known/jwks.json
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=

# Seeded superadmin — linked to the Clerk account with this email on first login
SUPERADMIN_EMAIL=neil.bearse@gmail.com

# Measured surface: OpenAI Responses API (Mode A runs). Runs fail loudly
# without the key; per-tenant monthly spend caps are enforced pre-dispatch.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Mode B scraping (chatgpt.com / perplexity.ai via the Playwright worker).
# Conservative rates; CHATGPT_WEB_HEADLESS=false only when debugging.
CHATGPT_WEB_RATE_PER_MIN=4
PERPLEXITY_WEB_RATE_PER_MIN=4
CHATGPT_WEB_HEADLESS=true

# Notifications (M5): run-completion reports by email. Leave SMTP_HOST empty
# to disable. Any transactional SMTP provider works.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=reports@yourdomain.com

# BigQuery mirror (§5.3): nightly append of run metadata to the existing
# warehouse. Leave BIGQUERY_PROJECT empty to disable. The service-account
# JSON must be a file path readable inside the containers.
BIGQUERY_PROJECT=
BIGQUERY_DATASET=everpresent_v3
GOOGLE_SERVICE_ACCOUNT_JSON=
MIRROR_HOUR_UTC=9

ENV=prod
